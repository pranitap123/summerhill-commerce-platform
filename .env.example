# Stage 1 scraper (scripts/scraper.js). Copy to .env and fill in; .env is git-ignored.
# Values come from the storefront's own requests (browser dev tools, Network tab). See docs/SCRAPER.md.
API_KEY=
LOCATION_ID=
PRICELIST_ID=
# API root, no trailing slash, e.g. https://api.example.com/v1
BASE_URL=
# Image host/path prefix; the scraper appends "/<mainImage>.jpg"
IMAGE_BASE=

# Optional
CURRENCY=CAD
OUTPUT_PATH=scraped.json
# Sent as the User-Agent. Origin and Referer are not sent unless you set them.
# USER_AGENT=
# ORIGIN=
# REFERER=
# Retry policy: attempts after the first, base backoff, per-request timeout
# MAX_RETRIES=4
# RETRY_BASE_DELAY_MS=1000
# REQUEST_TIMEOUT_MS=30000
