# Connection strings for the local compose stack, used by the root npm scripts (db:migrate,
# db:seed). Shell environment variables take precedence over these. Local defaults only.
MIGRATION_DATABASE_URL=postgres://grocery_admin:local_dev_only@127.0.0.1:5433/grocery
SEED_DATABASE_URL=postgres://grocery_admin:local_dev_only@127.0.0.1:5433/grocery
# The catalogue pipeline (/pipeline) runs as the least-privilege ingest role (ADR-0004)
INGEST_DATABASE_URL=postgres://ingest_rw:local_dev_only@127.0.0.1:5433/grocery
