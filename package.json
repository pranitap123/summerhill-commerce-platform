{
  "name": "summerhill-scraper",
  "version": "1.0.0",
  "description": "Grocery marketplace reference implementation (demo, Stripe test mode). Not affiliated with Summerhill Market.",
  "private": true,
  "main": "index.js",
  "scripts": {
    "stack:up": "docker compose -f infra/docker-compose.yml up -d --wait postgres elasticsearch mailpit",
    "stack:up:stripe": "docker compose -f infra/docker-compose.yml --profile stripe up -d --wait",
    "stack:full": "docker compose -f infra/docker-compose.yml --profile full up -d --build --wait",
    "stack:down": "docker compose -f infra/docker-compose.yml --profile full down",
    "stack:reset": "docker compose -f infra/docker-compose.yml --profile full down -v && npm run stack:up && npm run db:setup",
    "db:migrate": "node --env-file=infra/local.env db/migrate.mjs",
    "db:status": "node --env-file=infra/local.env db/migrate.mjs status",
    "db:generate": "node db/seed/generate.mjs",
    "db:seed": "node --env-file=infra/local.env db/seed/seed.mjs",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "pipeline:install": "node tools/pipeline.mjs install",
    "pipeline:test": "node tools/pipeline.mjs test",
    "pipeline:ingest": "node --env-file=infra/local.env tools/pipeline.mjs ingest",
    "pipeline:runs": "node --env-file=infra/local.env tools/pipeline.mjs runs",
    "pipeline:requests": "node --env-file=infra/local.env tools/pipeline.mjs process-requests",
    "pipeline:dagster": "node --env-file=infra/local.env tools/pipeline.mjs dagster",
    "payload:cleanup": "node tools/payload-cleanup.mjs",
    "ci:local": "node tools/ci-local.mjs",
    "ci:fast": "node tools/ci-local.mjs --fast",
    "scrape": "node scripts/scraper.js",
    "test:scraper": "node --test tests/scraper.test.js",
    "check": "npm run scan:secrets && npm run docs:check",
    "scan:secrets": "node tools/scan-secrets.mjs --all",
    "scan:history": "node tools/scan-secrets.mjs --history",
    "scan:headers": "node tools/observatory-local.mjs",
    "scan:zap": "node tools/zap-baseline.mjs",
    "scan:security": "node tools/observatory-local.mjs && node tools/zap-baseline.mjs",
    "stack:observability": "docker compose -f infra/docker-compose.yml --profile observability up -d jaeger",
    "test:load": "docker compose -f infra/docker-compose.yml --profile load run --rm k6",
    "docs:check": "node docs/tools/check-docs.mjs",
    "test": "npm run ci:fast"
  },
  "keywords": [],
  "author": "Pranita Panchal",
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.20.0",
    "dotenv": "^18.0.3",
    "pg": "^8.23.1"
  }
}
