{
  "name": "summerhill-commerce",
  "version": "1.0.0",
  "description": "Ecommerce template for Payload",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm --ignore-workspace install",
    "format:check": "prettier --check --end-of-line auto \"src/modules/**/*.{ts,tsx}\" \"src/server/**/*.ts\" \"src/worker/**/*.ts\" \"src/scripts/**/*.ts\" \"src/collections/Products/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test:authz": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts tests/authz",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "stripe-webhooks": "stripe listen --forward-to localhost:3000/api/payments/stripe/webhooks",
    "test": "npm run test:coverage && npm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts tests/integration",
    "dev:stack": "cross-env NODE_OPTIONS=--no-deprecation node scripts/with-env.mjs stack.env ./node_modules/next/dist/bin/next dev",
    "dev:sim": "cross-env NODE_OPTIONS=--no-deprecation node scripts/with-env.mjs stack.env,simulator.env ./node_modules/next/dist/bin/next dev",
    "build:sim": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=6000\" node scripts/with-env.mjs stack.env,simulator.env,simulator-build.env ./node_modules/next/dist/bin/next build --webpack",
    "start:sim": "cross-env NODE_OPTIONS=--no-deprecation node scripts/with-env.mjs stack.env,simulator.env,simulator-build.env ./node_modules/next/dist/bin/next start",
    "worker": "cross-env NODE_OPTIONS=--no-deprecation node scripts/with-env.mjs stack.env ./node_modules/tsx/dist/cli.mjs src/worker/main.ts",
    "worker:sim": "cross-env NODE_OPTIONS=--no-deprecation node scripts/with-env.mjs stack.env,simulator.env,simulator-build.env ./node_modules/tsx/dist/cli.mjs src/worker/main.ts",
    "seed:users": "cross-env NODE_OPTIONS=--no-deprecation node scripts/with-env.mjs stack.env ./node_modules/payload/bin.js run src/scripts/seed-demo-users.ts",
    "demo:totp": "cross-env NODE_OPTIONS=--no-deprecation node scripts/with-env.mjs stack.env ./node_modules/payload/bin.js run src/scripts/demo-totp.ts",
    "search:rebuild": "cross-env NODE_OPTIONS=--no-deprecation node scripts/with-env.mjs stack.env ./node_modules/payload/bin.js run src/scripts/search-rebuild.ts",
    "catalog:sync-payload": "cross-env NODE_OPTIONS=--no-deprecation node scripts/with-env.mjs stack.env ./node_modules/payload/bin.js run src/scripts/sync-payload-catalog.ts",
    "ops": "cross-env NODE_OPTIONS=--no-deprecation node scripts/with-env.mjs stack.env ./node_modules/payload/bin.js run src/scripts/ops.ts",
    "openapi": "./node_modules/tsx/dist/cli.mjs scripts/generate-openapi.ts",
    "test:unit": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts tests/unit tests/authz",
    "test:coverage": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts --coverage"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^9.4.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "~0.222.0",
    "@opentelemetry/instrumentation": "~0.222.0",
    "@opentelemetry/instrumentation-pg": "~0.74.0",
    "@opentelemetry/instrumentation-undici": "~0.32.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@payloadcms/admin-bar": "3.90.2",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/email-nodemailer": "3.90.2",
    "@payloadcms/live-preview-react": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-ecommerce": "3.90.2",
    "@payloadcms/plugin-form-builder": "3.90.2",
    "@payloadcms/plugin-seo": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@radix-ui/react-accordion": "1.2.11",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@stripe/react-stripe-js": "^3",
    "@stripe/stripe-js": "^4.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cross-env": "^7.0.3",
    "date-fns": "^4.1.0",
    "dotenv": "^16.6.1",
    "embla-carousel-auto-scroll": "^8.1.5",
    "embla-carousel-react": "^8.5.2",
    "framer-motion": "^13.4.4",
    "geist": "^1.3.0",
    "graphql": "^16.8.2",
    "jsonwebtoken": "9.0.1",
    "lucide-react": "0.563.0",
    "next": "16.4.0",
    "next-themes": "0.4.6",
    "nodemailer": "^9.1.1",
    "payload": "3.90.2",
    "pg": "^8.20.0",
    "pino": "^9.14.0",
    "prism-react-renderer": "^2.3.1",
    "qs-esm": "8.0.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "7.71.1",
    "sharp": "0.35.5",
    "sonner": "^1.7.2",
    "stripe": "^18.5.0",
    "tailwind-merge": "^3.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/eslintrc": "^3.2.0",
    "@next/eslint-plugin-next": "^15.5.4",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/react": "16.3.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "22.19.9",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vercel/git-hooks": "^1.0.0",
    "@vitejs/plugin-react": "4.5.2",
    "@vitest/coverage-v8": "4.0.18",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fast-check": "^4.10.2",
    "jsdom": "28.0.0",
    "lint-staged": "^15.2.2",
    "postcss": "^8.5.28",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.1.18",
    "tsx": "4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
