# Points the app at the local compose stack (infra/docker-compose.yml). Used by `npm run dev:stack`
# via `node --env-file`; values here override .env, and anything not set here (your Stripe TEST key,
# PAYLOAD_SECRET, publishable key) still comes from your own .env.
# Local-development defaults only: these are not secrets and must never be used anywhere else.

# Payload CMS database and the marketplace database (both as the least-privilege app role)
DATABASE_URL=postgres://app_rw:local_dev_only@127.0.0.1:5433/payload
CATALOG_DATABASE_URL=postgres://app_rw:local_dev_only@127.0.0.1:5433/grocery
ELASTICSEARCH_URL=http://127.0.0.1:9200
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Postgres connect timeout for local dev (production default: 5000 ms). Dev compilation can delay
# the handshake on slow machines.
DB_CONNECT_TIMEOUT_MS=20000

# Turbopack's on-disk dev cache. Off here because on slow disks every compile waits on cache
# writes (seen: 11–19 s per write, 71 s compactions). Set to true on a fast SSD.
NEXT_DEV_FS_CACHE=false

# Demo accounts created by `npm run seed:users` (local demo only)
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_CUSTOMER_EMAIL=customer@example.com
# Merchant console demo staff (G4-05): the demo store's owner and a picker
DEMO_OWNER_EMAIL=owner@example.com
DEMO_PICKER_EMAIL=picker@example.com
DEMO_USER_PASSWORD=demo-only-change-me
# Back-office demo accounts (G5): support (refunds up to $50, issues) and finance (payouts, recon)
DEMO_SUPPORT_EMAIL=support@example.com
DEMO_FINANCE_EMAIL=finance@example.com
# Staff two-step verification (G5-12): the demo staff accounts are enrolled with this TOTP secret so
# the demo and the end-to-end tests can compute codes (npm run demo:totp). Demo only: never reuse it.
DEMO_TOTP_SECRET=JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP
