# Payment simulator instead of Stripe (G4-18). Used with stack.env by `npm run dev:sim` /
# `npm run worker:sim` and by the end-to-end tests: checkout goes to /simulator/checkout/{id},
# which accepts Stripe's test card numbers (4242 4242 4242 4242, …). No Stripe account needed.
# Never used in production (the config refuses it there).
PAYMENT_PROVIDER=simulator
